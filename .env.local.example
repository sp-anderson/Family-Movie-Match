# TMDB — themoviedb.org > Settings > API > "API Key (v3 auth)"
TMDB_API_KEY=

# Google OAuth — console.cloud.google.com > APIs & Services > Credentials
# Authorized redirect URI must be:
#   https://family-movie-match.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   (for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In — requires an Apple Developer Program membership ($99/year).
# See MANUAL_SETUP.md for the full walkthrough (Services ID, Sign in with
# Apple key, and generating the JWT client secret).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Resend — resend.com, free tier is plenty for this. Used for magic-link
# sign-in emails and parental consent request/confirmation emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Family Movie Match <onboarding@resend.dev>

# Cron — protects /api/cron/purge-accounts (runs daily via Vercel Cron, see
# vercel.json) so it can't be triggered by anyone else. Generate with:
# openssl rand -base64 32
CRON_SECRET=

# Admin/CS support panel — comma-separated list of emails allowed to access
# /admin. Checked server-side against the real signed-in session on every
# admin API route, never trusted from the client. Example:
# ADMIN_EMAILS=you@gmail.com,cofounder@gmail.com
ADMIN_EMAILS=

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://family-movie-match.vercel.app

# Upstash Redis — created automatically when you add the "Upstash" Redis
# integration to this project from the Vercel Marketplace; it fills these in.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
